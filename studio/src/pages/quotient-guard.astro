---
import "../styles/global.css";
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Software-only public trace observatory for QuotientGuard."/><title>QuotientGuard Observatory</title></head>
<body><main id="qg-observatory" class="qg-shell">
<nav><a href="/">NOTICER CORE</a><b>QUOTIENT<span>GUARD</span></b><small>PUBLIC PROJECTION ONLY / NO PRIVATE TWIN DISPLAY</small></nav>
<header><div><p>ONLINE RELATION MONITOR · K10</p><h1>The shadow stays<br/><em>in shadow.</em></h1></div><aside>Observe only what an attacker may observe. Trigger drift, disorder, reconnect, or a broken binding. The guard reveals the first public divergence, then collapses safely into silence.</aside></header>
<section class="scenario-bar"><button class="active" data-scenario="nominal">CLEAN STREAM</button><button data-scenario="drift">DRIFT</button><button data-scenario="reorder">REORDER</button><button data-scenario="reconnect">RECONNECT</button><button data-scenario="binding">BINDING SWAP</button><button id="qg-play" class="play">▶ RUN LIVE</button></section>
<section class="observatory"><article class="scope"><small>OBSERVATION CONTRACT</small><h2>Public trace,<br/>nothing else.</h2><ul><li>common action projection</li><li>relation verdict</li><li>first divergence slot</li><li>capsule chain</li></ul><p>Private history, readiness, shadow state, and differing shadow index never enter this surface.</p></article>
<article class="stage"><div class="stage-head"><span>LIVE TRACE</span><b id="qg-step">1 / 10</b></div><div id="qg-trace" class="trace"></div><input id="qg-scrubber" type="range" min="0" max="9" value="0"/>
<div class="signal"><div><small>PUBLIC ACTION</small><strong id="qg-action">cover</strong></div><i>↔</i><div><small>SHADOW RELATION</small><strong id="qg-relation" class="relation equivalent">EQUIVALENT</strong></div><i>→</i><div class="sink"><small>GUARD STATE</small><strong id="qg-state" class="guard-state monitoring">MONITORING</strong></div></div><p id="qg-event" class="event">public projections remain action-equivalent</p></article></section>
<section class="evidence"><article><small>FIRST DIVERGENCE</small><strong id="qg-divergence">NONE</strong><p>Sticky witness. Later events cannot overwrite its slot.</p></article><article><small>RUNTIME EPOCH</small><strong id="qg-epoch">7</strong><p>Reconnect accepts only a verified, monotone capsule plus public reset.</p></article><article><small>CAPSULE CHAIN</small><strong id="qg-chain">VERIFIED</strong><div><code id="qg-previous">QG-GENESIS</code><i>→</i><code id="qg-capsule">--------</code></div></article></section>
<footer><span>Candidate runtime enforcement architecture</span><span>Software-only · bounded evidence · not a universal proof</span></footer>
<script>import { bootstrapGuardObservatory } from "../scripts/quotient-guard/observatory"; const root=document.querySelector<HTMLElement>("#qg-observatory"); if(root) bootstrapGuardObservatory(root);</script>
</main></body></html>
<style>
:global(*){box-sizing:border-box}:global(body){margin:0;background:#f0eee7;color:#111}.qg-shell{--red:#ff3b30;--black:#111;--cream:#f0eee7;--blue:#2367ff;min-height:100vh;padding:0 clamp(18px,4vw,68px) 35px;background:linear-gradient(90deg,transparent 49.8%,#d5d1c5 50%,transparent 50.2%);background-size:70px 70px;font-family:"Cascadia Mono","Courier New",monospace}nav{height:72px;display:flex;align-items:center;border-bottom:3px solid var(--black);font-size:.65rem;letter-spacing:.14em}nav a{color:inherit;text-decoration:none}nav>b{position:absolute;left:50%;transform:translateX(-50%);font-size:.8rem}nav>b span{color:var(--red)}nav small{margin-left:auto}header{min-height:330px;display:grid;grid-template-columns:1.4fr .6fr;align-items:end;padding:55px 0}header p{font-size:.65rem;letter-spacing:.18em;color:var(--red)}h1{margin:18px 0 0;font-family:"Arial Narrow","Franklin Gothic Medium",sans-serif;font-size:clamp(4rem,9vw,9rem);font-weight:900;letter-spacing:-.075em;line-height:.75;text-transform:uppercase}h1 em{color:var(--red);font-style:normal}header aside{padding:25px;border:3px solid var(--black);background:var(--cream);font-family:Georgia,serif;font-size:1.05rem;line-height:1.55;box-shadow:8px 8px 0 var(--red)}.scenario-bar{display:flex;background:var(--black)}.scenario-bar button{flex:1;padding:15px 8px;border:0;border-right:1px solid #555;background:transparent;color:#aaa;font:800 .62rem inherit;letter-spacing:.08em;cursor:pointer}.scenario-bar button.active{background:var(--red);color:white}.scenario-bar .play{background:var(--blue);color:white}.observatory{display:grid;grid-template-columns:260px 1fr;border:3px solid var(--black);border-top:0;background:var(--cream)}.scope{padding:28px;border-right:3px solid var(--black);background:var(--black);color:white}.scope small,.stage-head,.signal small,.evidence small{font-size:.58rem;letter-spacing:.15em;color:#888}.scope h2{font-family:Georgia,serif;font-size:2rem}.scope li{margin:12px 0;color:#d8ff57;font-size:.68rem}.scope p{margin-top:35px;color:#aaa;font-size:.68rem;line-height:1.6}.stage{padding:28px}.stage-head{display:flex;justify-content:space-between;color:#333}.trace{display:flex;align-items:center;height:120px}.trace-node{position:relative;flex:1;height:60px;border:0;border-top:3px solid #777;background:transparent;cursor:pointer}.trace-node i{position:absolute;top:-8px;left:45%;width:14px;height:14px;border-radius:50%;background:#222}.trace-node.safe_sink i{background:var(--red)}.trace-node.hold i{background:#eaa900}.trace-node.recovered i{background:var(--blue)}.trace-node.active i{transform:scale(1.8);box-shadow:0 0 0 5px #d8ff57}.trace-node b{display:block;margin-top:14px}.trace-node span{font-size:.55rem}.stage input{width:100%;accent-color:var(--red)}.signal{display:grid;grid-template-columns:1fr 40px 1fr 40px 1fr;align-items:center;margin-top:35px;text-align:center}.signal>div{padding:22px 8px;border:2px solid var(--black)}.signal .sink{background:var(--black);color:white}.signal strong{display:block;margin-top:12px;font-size:1rem}.relation.diverged,.guard-state.safe_sink{color:var(--red)}.relation.not_compared,.guard-state.hold{color:#eaa900}.guard-state.recovered{color:#73a0ff}.event{margin:24px 0 0;padding:12px;background:#dcd8cc;font-size:.68rem}.evidence{display:grid;grid-template-columns:1fr 1fr 1.4fr;gap:10px;margin-top:10px}.evidence article{min-height:150px;padding:23px;border:3px solid var(--black);background:var(--cream)}.evidence strong{display:block;margin:15px 0;font-family:"Arial Narrow",sans-serif;font-size:2rem}.evidence p{font-size:.65rem}.evidence article:last-child{background:var(--red);color:white}.evidence article:last-child small{color:#ffd0cc}.evidence article div{display:flex;align-items:center;gap:10px}.evidence code{padding:8px;background:#111;color:#d8ff57;font-size:.68rem}footer{display:flex;justify-content:space-between;padding-top:25px;font-size:.58rem;letter-spacing:.1em}@media(max-width:820px){header,.observatory,.evidence{grid-template-columns:1fr}.scope{border-right:0;border-bottom:3px solid var(--black)}.scenario-bar{flex-wrap:wrap}.scenario-bar button{flex-basis:32%}.signal{grid-template-columns:1fr}.signal>i{transform:rotate(90deg)}nav>b{position:static;margin-left:20px;transform:none}nav small{display:none}footer{gap:15px}}
</style>
