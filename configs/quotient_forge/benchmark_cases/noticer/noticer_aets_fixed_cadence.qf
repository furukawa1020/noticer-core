module noticer_aets_fixed_cadence version 1 {
  horizon 2;
  transducer_states <= 2;
  private {
    bool evidence_ready;
    enum margin { nominal, elevated };
  }

  public {
    bool network_available;
    slot now;
  }

  action notify {
    service menfugu;
    release_window 1..1;
    exactly_once;
  }

  quotient {
    by action notify;
    erase evidence_ready;
    erase margin;
  }

  observer network {
    sees send;
    sees packet_size;
    sees send_slot;
  }

  observer service(menfugu) {
    sees action_slot;
  }

  utility {
    obligation notify {
      exactly_once;
      release 1..1;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
