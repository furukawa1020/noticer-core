module noticer_aplot_bounded_loss version 1 {
  horizon 3;
  transducer_states <= 3;
  private {
    bool evidence_ready;
    enum margin { nominal, elevated };
  }

  public {
    bool network_available;
    slot now;
  }

  action notify {
    service menfugu;
    release_window 2..2;
    exactly_once;
  }

  quotient {
    by action notify;
    erase evidence_ready;
    erase margin;
  }

  observer network {
    sees send;
    sees packet_size;
    sees retry_count;
    sees send_slot;
  }

  observer service(menfugu) {
    sees action_slot;
  }

  fault bounded_loss {
    max_drop 1 per window 2;
    reorder <= 1;
  }

  utility {
    obligation notify {
      exactly_once;
      release 2..2;
      under fault bounded_loss;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
