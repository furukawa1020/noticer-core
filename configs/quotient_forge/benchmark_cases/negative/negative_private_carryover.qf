module negative_private_carryover version 1 {
  horizon 4;
  transducer_states <= 3;
  private {
    bool secret;
    enum private_class { left, right };
  }

  public {
    bool public_gate;
    slot now;
  }

  action act {
    service target;
    release_window 3..3;
    exactly_once;
  }

  quotient {
    by action act;
    erase secret;
    erase private_class;
  }

  observer network {
    sees send_slot;
    sees service_alias;
  }

  observer service(target) {
    sees action_slot;
  }

  utility {
    obligation act {
      exactly_once;
      release 3..3;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
    service_alias = private.secret;
  }
}
