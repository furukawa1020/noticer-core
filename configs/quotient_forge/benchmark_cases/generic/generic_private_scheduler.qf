module generic_private_scheduler version 1 {
  horizon 4;
  transducer_states <= 4;
  private {
    bool job_ready;
    enum schedule_choice { early, late };
  }

  public {
    bool public_gate;
    slot now;
  }

  action act {
    service scheduler;
    release_window 3..3;
    exactly_once;
  }

  quotient {
    by action act;
    erase job_ready;
    erase schedule_choice;
  }

  observer network {
    sees frame_kind;
    sees send_slot;
  }

  observer service(scheduler) {
    sees action_slot;
  }

  utility {
    obligation act {
      exactly_once;
      release 3..3;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
