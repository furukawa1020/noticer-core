module generic_public_retry version 1 {
  horizon 3;
  transducer_states <= 3;
  private {
    bool request_origin;
    enum retry_cause { first, repeated };
  }

  public {
    bool public_gate;
    slot now;
    bool retry_requested;
  }

  action act {
    service retry_service;
    release_window 2..2;
    exactly_once;
  }

  quotient {
    by action act;
    erase request_origin;
    erase retry_cause;
  }

  observer network {
    sees retry_count;
    sees send_slot;
  }

  observer service(retry_service) {
    sees action_slot;
  }

  utility {
    obligation act {
      exactly_once;
      release 2..2;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
