module generic_delayed_notification version 1 {
  horizon 3;
  transducer_states <= 3;
  private {
    bool trigger_ready;
    enum delay_class { short, long };
  }

  public {
    bool public_gate;
    slot now;
  }

  action act {
    service notification;
    release_window 2..2;
    exactly_once;
  }

  quotient {
    by action act;
    erase trigger_ready;
    erase delay_class;
  }

  observer network {
    sees send_slot;
  }

  observer service(notification) {
    sees action_slot;
  }

  utility {
    obligation act {
      exactly_once;
      release 2..2;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
