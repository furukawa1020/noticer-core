module generic_fixed_size_release version 1 {
  horizon 2;
  transducer_states <= 2;
  private {
    bool content_ready;
    enum content_class { small, large };
  }

  public {
    bool public_gate;
    slot now;
  }

  action act {
    service release;
    release_window 1..1;
    exactly_once;
  }

  quotient {
    by action act;
    erase content_ready;
    erase content_class;
  }

  observer network {
    sees packet_size;
    sees send;
    sees send_slot;
  }

  observer service(release) {
    sees action_slot;
  }

  utility {
    obligation act {
      exactly_once;
      release 1..1;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
