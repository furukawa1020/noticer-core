module generic_activity_actuator version 1 {
  horizon 5;
  transducer_states <= 5;
  private {
    bool private_activity;
    enum motion_hint { still, moving };
  }

  public {
    bool public_gate;
    slot now;
    bool action_enabled;
  }

  action act {
    service activity;
    release_window 4..4;
    exactly_once;
  }

  quotient {
    by action act;
    erase private_activity;
    erase motion_hint;
  }

  observer network {
    sees send_slot;
    sees service_alias;
  }

  observer service(activity) {
    sees action_slot;
  }

  utility {
    obligation act {
      exactly_once;
      release 4..4;
    }
    forbid unauthorized_action;
  }

  objective lexicographic {
    minimize dummy_frames;
    minimize worst_latency;
  }

  release {
    send_slot = public.now;
  }
}
