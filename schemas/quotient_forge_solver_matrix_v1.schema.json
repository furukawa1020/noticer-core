{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer-core.invalid/schemas/quotient_forge_solver_matrix_v1.schema.json",
  "title": "QuotientForge pinned solver matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selection_order", "artifact_fields", "solvers", "network_policy", "security_interpretation"],
  "properties": {
    "schema_version": {"const": "quotient-forge-solver-matrix/v1"},
    "selection_order": {"const": ["cvc5", "z3"]},
    "artifact_fields": {"const": ["solver", "version", "platform", "asset_sha256", "matrix_sha256", "argv"]},
    "solvers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/solver"}
    },
    "network_policy": {"const": "DOWNLOAD_ONLY_WITH_SHA256"},
    "security_interpretation": {"const": "CANDIDATE_GENERATOR_NOT_SECURITY_ORACLE"}
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "archive_name", "download_url", "sha256", "executable_path"],
      "properties": {
        "platform": {"enum": ["linux-x86_64", "windows-x86_64"]},
        "archive_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.zip$"},
        "download_url": {"type": "string", "pattern": "^https://github\\.com/.+/releases/download/.+/.+\\.zip$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "release_tag", "release_url", "version_output_prefix", "commands", "assets"],
      "properties": {
        "id": {"enum": ["cvc5", "z3"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "release_tag": {"type": "string"},
        "release_url": {"type": "string", "pattern": "^https://github\\.com/.+/releases/tag/.+$"},
        "version_output_prefix": {"type": "string", "minLength": 1},
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "probe", "solve"],
          "properties": {
            "version": {"$ref": "#/$defs/argv"},
            "probe": {"$ref": "#/$defs/argv"},
            "solve": {"$ref": "#/$defs/argv"}
          }
        },
        "assets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/asset"}
        }
      }
    }
  }
}
