{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/quotient_forge_typed_blocker_v1.schema.json",
  "title": "QuotientForge typed blocker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bounded_only",
    "class",
    "epoch",
    "problem_sha256",
    "source_candidate_sha256",
    "counterexample_sha256",
    "blocker_sha256",
    "assignments"
  ],
  "properties": {
    "schema_version": { "const": "noticer.quotient_forge.typed_blocker.v1" },
    "bounded_only": { "const": true },
    "class": { "enum": ["SECURITY", "UTILITY", "FAULT"] },
    "epoch": { "type": "integer", "minimum": 0 },
    "problem_sha256": { "$ref": "#/$defs/digest" },
    "source_candidate_sha256": { "$ref": "#/$defs/digest" },
    "counterexample_sha256": { "$ref": "#/$defs/digest" },
    "blocker_sha256": { "$ref": "#/$defs/digest" },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machine_state", "symbol", "next_state", "output"],
        "properties": {
          "machine_state": { "type": "integer", "minimum": 0 },
          "symbol": { "type": "integer", "minimum": 0 },
          "next_state": { "type": "integer", "minimum": 0 },
          "output": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
