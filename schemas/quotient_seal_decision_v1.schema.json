{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer-core.invalid/schemas/quotient_seal_decision_v1.schema.json",
  "title": "QuotientSeal Go Pivot Kill decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "scope", "run_id", "source_commit", "hardware_status", "policy_sha256", "input_sha256", "decision", "decision_precedence", "aggregation", "axis_results", "reasons", "sensitivity", "falsification_conditions", "boundaries", "integrity"],
  "properties": {
    "schema_version": {"const": "quotient-seal-decision/v1"},
    "decision_id": {"$ref": "#/$defs/digest"},
    "scope": {"const": "QUOTIENTSEAL_SOFTWARE_EVALUATION"},
    "run_id": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hardware_status": {"const": "NOT_VERIFIED"},
    "policy_sha256": {"$ref": "#/$defs/digest"},
    "input_sha256": {"$ref": "#/$defs/digest"},
    "decision": {"enum": ["GO", "PIVOT", "KILL"]},
    "decision_precedence": {"const": ["KILL", "PIVOT", "GO"]},
    "aggregation": {"const": "NON_COMPENSATORY"},
    "axis_results": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object"}},
    "reasons": {"type": "array", "items": {"type": "object"}},
    "sensitivity": {"type": "array", "minItems": 26, "items": {"type": "object"}},
    "falsification_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "boundaries": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "coverage", "report_sha256"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "coverage": {"const": "ALL_REPORT_FIELDS_EXCEPT_INTEGRITY"},
        "report_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
