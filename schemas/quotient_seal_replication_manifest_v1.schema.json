{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/quotient_seal_replication_manifest_v1.schema.json",
  "title": "QuotientSeal Replication Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_version",
    "repository",
    "toolchains",
    "k7_dependencies",
    "inventory",
    "evidence_origin",
    "security_interpretation",
    "hardware_status",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "quotient-seal.replication-manifest.v1"},
    "manifest_version": {"const": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "baseline_commit", "revision_policy"],
      "properties": {
        "name": {"const": "furukawa1020/noticer-core"},
        "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "revision_policy": {"const": "DESCENDANT_OF_BASELINE"}
      }
    },
    "toolchains": {
      "type": "array",
      "minItems": 5,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source", "required_marker", "source_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "required_marker": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "k7_dependencies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "name", "commit"],
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "bytes", "sha256"],
        "properties": {
          "kind": {"enum": ["TOOLCHAIN", "LOCKFILE", "CONFIG", "SCHEMA", "SOURCE", "FORMAL", "DOC"]},
          "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "evidence_origin": {"const": "REPOSITORY_CONTRACT"},
    "security_interpretation": {"const": "NOT_A_SECURITY_VERDICT"},
    "hardware_status": {"const": "NOT_VERIFIED"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

