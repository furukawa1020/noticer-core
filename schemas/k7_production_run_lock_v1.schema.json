{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/k7_production_run_lock_v1.schema.json",
  "title": "K7 production backend run lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment_id", "registry_sha256", "backends", "run_lock_sha256"],
  "properties": {
    "schema": { "const": "noticer.k7.production-run-lock.v1" },
    "environment_id": { "type": "string", "minLength": 1 },
    "registry_sha256": { "$ref": "#/$defs/digest" },
    "run_lock_sha256": { "$ref": "#/$defs/digest" },
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "cegis", "smt", "qbf"],
      "properties": {
        "reference": { "$ref": "#/$defs/backend" },
        "cegis": { "$ref": "#/$defs/backend" },
        "smt": { "$ref": "#/$defs/backend" },
        "qbf": { "$ref": "#/$defs/backend" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_sha256", "executable_sha256", "executable", "argv"],
      "properties": {
        "binding_sha256": { "$ref": "#/$defs/digest" },
        "executable_sha256": { "$ref": "#/$defs/digest" },
        "executable": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
