{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/k7_benchmark_case_v1.schema.json",
  "title": "K7 canonical AQRS benchmark case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "family_id",
    "variant_id",
    "split",
    "aqrs",
    "dimensions",
    "feature_tags",
    "obligations",
    "expected_outcome_class",
    "difficulty_tier",
    "author_template_sha256"
  ],
  "properties": {
    "schema": {
      "const": "noticer.k7.aqrs-benchmark-case.v1"
    },
    "family_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 64
    },
    "variant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 64
    },
    "split": {
      "enum": ["development", "held_out", "train"]
    },
    "aqrs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language_version", "canonical_source_sha256"],
      "properties": {
        "language_version": {
          "const": 1
        },
        "canonical_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plant_states",
        "plant_transitions",
        "machine_state_bound",
        "machine_symbol_count",
        "horizon",
        "observer_count",
        "observer_dimensions"
      ],
      "properties": {
        "plant_states": {"type": "integer", "minimum": 1, "maximum": 4096},
        "plant_transitions": {"type": "integer", "minimum": 1, "maximum": 16384},
        "machine_state_bound": {"type": "integer", "minimum": 1, "maximum": 256},
        "machine_symbol_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "horizon": {"type": "integer", "minimum": 1, "maximum": 256},
        "observer_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "observer_dimensions": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "feature_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": ["collusion", "failure", "longitudinal", "retry", "silence", "size", "timing"]
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["action_window", "bounded_loss", "exactly_once", "reconnect"]
      }
    },
    "expected_outcome_class": {
      "enum": ["INVALID", "REALIZABLE", "UNREALIZABLE"]
    },
    "difficulty_tier": {
      "enum": ["D1", "D2", "D3", "D4", "D5"]
    },
    "author_template_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"split": {"const": "held_out"}},
        "required": ["split"]
      },
      "then": {
        "properties": {"author_template_sha256": {"type": "null"}}
      }
    }
  ]
}
