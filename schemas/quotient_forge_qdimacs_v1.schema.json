{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/quotient_forge_qdimacs_v1.schema.json",
  "title": "QuotientForge QDIMACS Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bounds", "seed", "variable_count", "clause_count", "quantifier_blocks", "variables", "qdimacs_sha256"],
  "properties": {
    "schema_version": { "const": "noticer.quotient_forge.qdimacs.v1" },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plant_states", "machine_states", "horizon", "action_count"],
      "properties": {
        "plant_states": { "type": "integer", "minimum": 1 },
        "machine_states": { "type": "integer", "minimum": 1 },
        "horizon": { "type": "integer", "minimum": 1 },
        "action_count": { "type": "integer", "minimum": 1 }
      }
    },
    "seed": { "type": "integer", "minimum": 0 },
    "variable_count": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "clause_count": { "type": "integer", "minimum": 0, "maximum": 4000000 },
    "quantifier_blocks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "variables"],
        "properties": {
          "kind": { "enum": ["EXISTENTIAL", "UNIVERSAL"] },
          "variables": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1, "maximum": 1000000 }
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "coordinates"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "role": {
            "enum": ["MACHINE_CHOICE", "PRIVATE_HISTORY_LEFT", "PRIVATE_HISTORY_RIGHT", "ENVIRONMENT_TRACE", "FAULT_TRACE", "DEPENDENT_WITNESS"]
          },
          "coordinates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "integer", "minimum": 0, "maximum": 1000000000 }
          }
        }
      }
    },
    "qdimacs_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
