{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer-core.example/schemas/k8_raqtr_contract.schema.json",
  "title": "K8 RAQTR frozen research contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "state",
    "freeze_date",
    "parent_issue",
    "implementation_issue",
    "amendment_policy",
    "hypothesis",
    "dependencies",
    "reuse",
    "security",
    "evaluation",
    "seeds",
    "limits",
    "artifacts",
    "decision",
    "change_history"
  ],
  "properties": {
    "schema": { "const": "noticer-k8-raqtr-contract-v1" },
    "contract_version": { "const": 1 },
    "state": { "const": "FROZEN" },
    "freeze_date": { "const": "2026-08-17" },
    "parent_issue": { "const": 95 },
    "implementation_issue": { "const": 96 },
    "amendment_policy": { "const": "new_version_required" },
    "hypothesis": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k7_02", "k7_03", "k7_10"],
      "properties": {
        "k7_02": { "$ref": "#/$defs/dependency" },
        "k7_03": { "$ref": "#/$defs/dependency" },
        "k7_10": { "$ref": "#/$defs/dependency" }
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_equivalence",
        "source_certificate",
        "generated_runtime",
        "copy_unmerged_k7_types_allowed",
        "redefine_k7_manifest_allowed",
        "redefine_k7_certificate_allowed"
      ],
      "properties": {
        "action_equivalence": { "$ref": "#/$defs/source_reference" },
        "source_certificate": { "$ref": "#/$defs/producer_reference" },
        "generated_runtime": { "$ref": "#/$defs/issue_reference" },
        "copy_unmerged_k7_types_allowed": { "const": false },
        "redefine_k7_manifest_allowed": { "const": false },
        "redefine_k7_certificate_allowed": { "const": false }
      }
    },
    "security": { "$ref": "#/$defs/security" },
    "evaluation": { "$ref": "#/$defs/evaluation" },
    "seeds": { "$ref": "#/$defs/positive_integer_object" },
    "limits": { "$ref": "#/$defs/positive_integer_object" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "decision": { "$ref": "#/$defs/decision" },
    "change_history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "unique_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "requirement", "status", "merge_commit"],
      "properties": {
        "issue": { "type": "integer", "minimum": 1 },
        "requirement": { "$ref": "#/$defs/identifier" },
        "status": { "enum": ["MERGED", "REQUIRED_UNMERGED"] },
        "merge_commit": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          ]
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "symbol"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "producer_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "producer"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "producer": { "$ref": "#/$defs/identifier" }
      }
    },
    "issue_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "producer"],
      "properties": {
        "issue": { "type": "integer", "minimum": 1 },
        "producer": { "$ref": "#/$defs/identifier" }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "events"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "events": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "adversary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "allowed", "forbidden"],
      "properties": {
        "class": { "$ref": "#/$defs/identifier" },
        "allowed": { "$ref": "#/$defs/unique_identifiers" },
        "forbidden": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notion",
        "abbreviation",
        "artifact",
        "artifact_abbreviation",
        "artifact_extension",
        "guarantees",
        "observer_profiles",
        "adversary",
        "utility",
        "tcb",
        "untrusted",
        "nonclaims"
      ],
      "properties": {
        "notion": { "const": "robust_action_quotient_trace_refinement" },
        "abbreviation": { "const": "RAQTR" },
        "artifact": { "const": "quotient_sealed_module" },
        "artifact_abbreviation": { "const": "QSM" },
        "artifact_extension": { "const": ".qseal" },
        "guarantees": { "$ref": "#/$defs/unique_identifiers" },
        "observer_profiles": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/observer" }
        },
        "adversary": { "$ref": "#/$defs/adversary" },
        "utility": { "$ref": "#/$defs/unique_identifiers" },
        "tcb": { "$ref": "#/$defs/unique_identifiers" },
        "untrusted": { "$ref": "#/$defs/unique_identifiers" },
        "nonclaims": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "counterexample", "inconclusive", "invalid"],
      "properties": {
        "success": { "$ref": "#/$defs/unique_identifiers" },
        "counterexample": { "$ref": "#/$defs/unique_identifiers" },
        "inconclusive": { "$ref": "#/$defs/unique_identifiers" },
        "invalid": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "split_unit",
        "row_random_split_allowed",
        "splits",
        "warmup_runs",
        "repetitions",
        "gates",
        "outcomes",
        "stop_conditions",
        "metrics"
      ],
      "properties": {
        "split_unit": { "const": "module_family" },
        "row_random_split_allowed": { "const": false },
        "splits": { "$ref": "#/$defs/unique_identifiers" },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "gates": { "$ref": "#/$defs/nonnegative_number_object" },
        "outcomes": { "$ref": "#/$defs/outcomes" },
        "stop_conditions": { "$ref": "#/$defs/unique_identifiers" },
        "metrics": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "positive_integer_object": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "nonnegative_number_object": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "contract_schema_path",
        "generated_committed",
        "private_field_count",
        "required_outputs",
        "forbidden_keys"
      ],
      "properties": {
        "root": { "const": "artifacts/k8_quotient_seal" },
        "contract_schema_path": {
          "const": "schemas/k8_raqtr_contract.schema.json"
        },
        "generated_committed": { "const": false },
        "private_field_count": { "const": 0 },
        "required_outputs": { "$ref": "#/$defs/unique_identifiers" },
        "forbidden_keys": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_all", "pivot_any", "kill_any"],
      "properties": {
        "go_all": { "$ref": "#/$defs/unique_identifiers" },
        "pivot_any": { "$ref": "#/$defs/unique_identifiers" },
        "kill_any": { "$ref": "#/$defs/unique_identifiers" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "reason"],
      "properties": {
        "version": { "const": 1 },
        "date": { "const": "2026-08-17" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
