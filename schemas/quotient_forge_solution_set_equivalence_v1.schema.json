{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/quotient_forge_solution_set_equivalence_v1.schema.json",
  "title": "QuotientForge small-model solution-set equivalence artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "problem_sha256",
    "quotient_artifact_sha256",
    "preservation_artifact_sha256",
    "mapping_commitment_sha256",
    "frozen_domain_sha256",
    "seed",
    "control_state_count",
    "source_state_count",
    "quotient_class_count",
    "symbol_count",
    "output_count",
    "max_candidates_per_side",
    "unreduced_generated_candidates",
    "reduced_generated_candidates",
    "unreduced_checker_calls",
    "reduced_checker_calls",
    "lift_checker_calls",
    "unreduced_valid_candidates",
    "reduced_valid_candidates",
    "checker_inconclusive_count",
    "checker_disagreement_count",
    "unreduced_solution_sha256",
    "reduced_lifted_solution_sha256",
    "missing_solution_sha256",
    "spurious_solution_sha256",
    "missing_witness",
    "spurious_witness",
    "sets_equal",
    "status",
    "private_values_included",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": { "const": "noticer.quotient_forge.solution_set_equivalence.v1" },
    "problem_sha256": { "$ref": "#/$defs/sha256" },
    "quotient_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "preservation_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "mapping_commitment_sha256": { "$ref": "#/$defs/sha256" },
    "frozen_domain_sha256": { "$ref": "#/$defs/sha256" },
    "seed": { "type": "integer", "minimum": 0 },
    "control_state_count": { "type": "integer", "minimum": 1, "maximum": 6 },
    "source_state_count": { "type": "integer", "minimum": 1 },
    "quotient_class_count": { "type": "integer", "minimum": 1 },
    "symbol_count": { "type": "integer", "minimum": 1 },
    "output_count": { "type": "integer", "minimum": 1 },
    "max_candidates_per_side": { "type": "integer", "minimum": 1 },
    "unreduced_generated_candidates": { "type": "integer", "minimum": 1 },
    "reduced_generated_candidates": { "type": "integer", "minimum": 1 },
    "unreduced_checker_calls": { "type": "integer", "minimum": 1 },
    "reduced_checker_calls": { "type": "integer", "minimum": 1 },
    "lift_checker_calls": { "type": "integer", "minimum": 1 },
    "unreduced_valid_candidates": { "type": "integer", "minimum": 0 },
    "reduced_valid_candidates": { "type": "integer", "minimum": 0 },
    "checker_inconclusive_count": { "type": "integer", "minimum": 0 },
    "checker_disagreement_count": { "type": "integer", "minimum": 0 },
    "unreduced_solution_sha256": { "$ref": "#/$defs/digestSet" },
    "reduced_lifted_solution_sha256": { "$ref": "#/$defs/digestSet" },
    "missing_solution_sha256": { "$ref": "#/$defs/digestSet" },
    "spurious_solution_sha256": { "$ref": "#/$defs/digestSet" },
    "missing_witness": { "oneOf": [{ "$ref": "#/$defs/witness" }, { "type": "null" }] },
    "spurious_witness": { "oneOf": [{ "$ref": "#/$defs/witness" }, { "type": "null" }] },
    "sets_equal": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "inconclusive"] },
    "private_values_included": { "const": false },
    "artifact_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digestSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonical_solution_sha256"],
      "properties": {
        "kind": { "enum": ["missing", "spurious"] },
        "canonical_solution_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
