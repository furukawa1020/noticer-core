{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.invalid/schemas/k7_benchmark_family_manifest_v1.schema.json",
  "title": "Noticer K7 frozen benchmark family manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_catalog_sha256",
    "category_counts",
    "contract_sha256",
    "contract_version",
    "family_count",
    "private_field_count",
    "registry_sha256",
    "row_random_split_allowed",
    "schema",
    "split_counts",
    "split_sha256",
    "split_unit",
    "state",
    "variant_policy_sha256"
  ],
  "properties": {
    "schema": { "const": "noticer-k7-benchmark-family-manifest-v1" },
    "contract_version": { "const": 1 },
    "state": { "const": "FROZEN" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "benchmark_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "split_sha256": { "$ref": "#/$defs/sha256" },
    "variant_policy_sha256": { "$ref": "#/$defs/sha256" },
    "split_unit": { "const": "spec_family" },
    "row_random_split_allowed": { "const": false },
    "family_count": { "const": 24 },
    "category_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generic", "negative", "noticer"],
      "properties": {
        "generic": { "const": 8 },
        "negative": { "const": 8 },
        "noticer": { "const": 8 }
      }
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "held_out", "train"],
      "properties": {
        "development": { "const": 8 },
        "held_out": { "const": 8 },
        "train": { "const": 8 }
      }
    },
    "private_field_count": { "const": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
