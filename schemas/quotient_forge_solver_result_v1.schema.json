{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/quotient_forge_solver_result_v1.schema.json",
  "title": "QuotientForge Solver Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "query_sha256", "stdout_sha256", "stderr_sha256", "result", "independent_checker", "diagnostic"],
  "properties": {
    "schema_version": { "const": "noticer.quotient_forge.solver_result.v1" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solver", "version", "platform", "binary_sha256", "matrix_sha256", "program", "argv", "timeout_ms", "seed", "search_bound"],
      "properties": {
        "solver": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "matrix_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "program": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "search_bound": { "type": "string" }
      }
    },
    "query_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result": { "enum": ["SAT", "UNSAT_AT_BOUND", "UNKNOWN", "TIMEOUT", "MALFORMED"] },
    "independent_checker": { "enum": ["ACCEPTED", "REJECTED", "NOT_APPLICABLE"] },
    "diagnostic": { "type": ["string", "null"] }
  }
}
