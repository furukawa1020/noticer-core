{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noticer.example/schemas/quotient_forge_quotient_lift_v1.schema.json",
  "title": "QuotientForge quotient lift artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "problem_sha256",
    "quotient_artifact_sha256",
    "preservation_artifact_sha256",
    "mapping_commitment_sha256",
    "reduced_candidate_sha256",
    "lifted_candidate_sha256",
    "source_state_count",
    "quotient_class_count",
    "reduced_cell_count",
    "lifted_cell_count",
    "mapping_total",
    "mapping_unique",
    "mapping_surjective",
    "checker_calls",
    "checker_decision",
    "accepted",
    "source_indices_included",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": { "const": "noticer.quotient_forge.quotient_lift.v1" },
    "problem_sha256": { "$ref": "#/$defs/sha256" },
    "quotient_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "preservation_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "mapping_commitment_sha256": { "$ref": "#/$defs/sha256" },
    "reduced_candidate_sha256": { "$ref": "#/$defs/sha256" },
    "lifted_candidate_sha256": { "$ref": "#/$defs/sha256" },
    "source_state_count": { "type": "integer", "minimum": 1 },
    "quotient_class_count": { "type": "integer", "minimum": 1 },
    "reduced_cell_count": { "type": "integer", "minimum": 1 },
    "lifted_cell_count": { "type": "integer", "minimum": 1 },
    "mapping_total": { "const": true },
    "mapping_unique": { "const": true },
    "mapping_surjective": { "const": true },
    "checker_calls": { "const": 1 },
    "checker_decision": { "enum": ["valid", "invalid", "inconclusive"] },
    "accepted": { "type": "boolean" },
    "source_indices_included": { "const": false },
    "artifact_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
