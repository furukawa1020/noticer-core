{
  "schema": "noticer-core.k7-toolchain-lock.v1",
  "network_policy": "OFFLINE_INSPECTION_ONLY",
  "toolchains": [
    {
      "argv": ["python", "--version"],
      "id": "python",
      "required_marker": "requires-python = \">=3.11\"",
      "source": "pyproject.toml",
      "version": "3.11.x",
      "version_pattern": "^Python 3\\.11\\.[0-9]+"
    },
    {
      "argv": ["rustc", "--version"],
      "id": "rust",
      "required_marker": "channel = \"1.93.0\"",
      "source": "rust-toolchain.toml",
      "version": "1.93.0",
      "version_pattern": "^rustc 1\\.93\\.0(?: |$)"
    },
    {
      "argv": ["node", "--version"],
      "id": "node",
      "required_marker": "node-version: \"24\"",
      "source": ".github/workflows/ci.yml",
      "version": "24.x",
      "version_pattern": "^v24\\.[0-9]+\\.[0-9]+"
    },
    {
      "argv": ["lean", "--version"],
      "id": "lean",
      "required_marker": "leanprover/lean4:v4.30.0",
      "source": "formal/aqrs/lean-toolchain",
      "version": "4.30.0",
      "version_pattern": "^Lean \\(version 4\\.30\\.0(?:,|\\))"
    },
    {
      "argv": ["cvc5", "--version"],
      "id": "cvc5",
      "required_marker": "This is cvc5 version 1.3.4",
      "source": "configs/quotient_forge/solver_matrix_v1.json",
      "version": "1.3.4",
      "version_pattern": "^This is cvc5 version 1\\.3\\.4(?: |$)"
    },
    {
      "argv": ["z3", "-version"],
      "id": "z3",
      "required_marker": "Z3 version 4.16.0",
      "source": "configs/quotient_forge/solver_matrix_v1.json",
      "version": "4.16.0",
      "version_pattern": "^Z3 version 4\\.16\\.0(?: |$)"
    }
  ],
  "hardware_status": "NOT_VERIFIED",
  "security_interpretation": "NOT_A_SECURITY_VERDICT"
}
